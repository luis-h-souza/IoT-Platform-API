# API
NODE_ENV=development
PORT=3000

# PostgreSQL / Neon
# Runtime da aplicação: conexão pooled (hostname Neon com -pooler).
DATABASE_URL=
# Prisma CLI e migrações: conexão direta (hostname sem -pooler).
DIRECT_URL=

# Segredo de integração servidor-servidor (não usar no firmware)
SGM_INTEGRATION_TOKEN=

# Configuração opcional
LOG_LEVEL=info
